---
interface Props {
  activePath: string;
}
const { activePath } = Astro.props;

const items = [
  {
    href: '/',
    label: 'Home',
    match: (path: string) => path === '/',
    icon: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V21h13V9.5"/>',
  },
  {
    href: '/exercises',
    label: 'Exercises',
    match: (path: string) => path.startsWith('/exercises'),
    icon: '<path d="M4 9v6M8 6v12M16 6v12M20 9v6M8 12h8"/>',
  },
  {
    href: '/routines',
    label: 'Routines',
    match: (path: string) => path.startsWith('/routines'),
    icon: '<path d="M6 4h12M6 9h12M6 14h8M6 19h5"/>',
  },
  {
    href: '/body',
    label: 'Body',
    match: (path: string) => path.startsWith('/body'),
    icon: '<path d="M4 17c2.2-4 4.2-6 6-6s3.4 1.6 5 4 3.2 3 5 2"/><circle cx="12" cy="7" r="3"/>',
  },
];
---

<nav class="bottom-nav" aria-label="Primary">
  <div class="bottom-nav-inner">
    {
      items.map((item) => (
        <a
          class:list={['nav-item', item.match(activePath) && 'active']}
          href={item.href}
          aria-current={item.match(activePath) ? 'page' : undefined}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={item.icon}
          />
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
</nav>
