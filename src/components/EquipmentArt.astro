---
import { BAR_WEIGHT, PLATE_SPECS, type PlateSpec } from '../lib/plates';
import type { EquipmentCategory } from '../lib/types';

interface Props {
  category: EquipmentCategory;
  load?: number;
  compact?: boolean;
}

const { category, load = BAR_WEIGHT } = Astro.props;

const perSide = Math.max(0, (Number.isFinite(load) ? load : BAR_WEIGHT) - BAR_WEIGHT) / 2;
const plates: PlateSpec[] = [];
let remaining = perSide;
for (const plate of PLATE_SPECS) {
  while (remaining >= plate.weight && plates.length < 6) {
    plates.push(plate);
    remaining -= plate.weight;
  }
}
---

{
  category === 'barbell' && (
    <svg viewBox="0 0 320 150" role="img" aria-label="Barbell illustration">
      <defs>
        <linearGradient id="bar-metal" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#E6E6EB" />
          <stop offset="45%" stop-color="#A4A4AD" />
          <stop offset="100%" stop-color="#66666F" />
        </linearGradient>
        <linearGradient id="plate-shine" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" stop-color="rgba(255,255,255,0.32)" />
          <stop offset="100%" stop-color="rgba(255,255,255,0)" />
        </linearGradient>
      </defs>
      <ellipse cx="160" cy="136" rx="118" ry="5" fill="rgba(0,0,0,0.34)" />
      <rect x="35" y="72" width="250" height="7" rx="3.5" fill="url(#bar-metal)" />
      <rect x="28" y="67" width="9" height="17" rx="2" fill="#8D8D96" />
      <rect x="283" y="67" width="9" height="17" rx="2" fill="#8D8D96" />
      {plates.map((plate, index) => (
        <g>
          <rect
            x={118 - index * 11}
            y={75 - plate.height / 2}
            width={plate.width}
            height={plate.height}
            rx="3"
            fill={plate.color}
            stroke="rgba(255,255,255,0.2)"
            stroke-width="1"
          />
          <rect
            x={118 - index * 11}
            y={75 - plate.height / 2}
            width={plate.width}
            height={plate.height}
            rx="3"
            fill="url(#plate-shine)"
          />
          <rect
            x={202 + index * 11}
            y={75 - plate.height / 2}
            width={plate.width}
            height={plate.height}
            rx="3"
            fill={plate.color}
            stroke="rgba(255,255,255,0.2)"
            stroke-width="1"
          />
          <rect
            x={202 + index * 11}
            y={75 - plate.height / 2}
            width={plate.width}
            height={plate.height}
            rx="3"
            fill="url(#plate-shine)"
          />
        </g>
      ))}
      <rect x="112" y="58" width="7" height="26" rx="2" fill="#CFCFD6" />
      <rect x="201" y="58" width="7" height="26" rx="2" fill="#CFCFD6" />
      <text x="160" y="128" text-anchor="middle" fill="#5C5C63" font-size="9" font-family="system-ui" letter-spacing="1.4">
        {Math.round(load)} LB
      </text>
    </svg>
  )
}

{
  category === 'dumbbell' && (
    <svg viewBox="0 0 320 150" role="img" aria-label="Dumbbell illustration">
      <defs>
        <linearGradient id="db-metal" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#D8D8DE" />
          <stop offset="100%" stop-color="#67676F" />
        </linearGradient>
      </defs>
      <ellipse cx="160" cy="128" rx="92" ry="5" fill="rgba(0,0,0,0.34)" />
      <rect x="88" y="70" width="144" height="10" rx="5" fill="url(#db-metal)" />
      {[0, 1, 2].map((index) => (
        <g>
          <rect x={90 - index * 10} y={54 - index * 4} width="12" height={42 + index * 8} rx="4" fill="#3C3C42" stroke="rgba(255,255,255,0.1)" />
          <rect x={218 + index * 10} y={54 - index * 4} width="12" height={42 + index * 8} rx="4" fill="#3C3C42" stroke="rgba(255,255,255,0.1)" />
        </g>
      ))}
      <text x="160" y="128" text-anchor="middle" fill="#5C5C63" font-size="9" font-family="system-ui" letter-spacing="1.4">
        {Math.round(load)} LB
      </text>
    </svg>
  )
}

{
  category === 'machine' && (
    <svg viewBox="0 0 320 150" role="img" aria-label="Machine illustration">
      <defs>
        <linearGradient id="machine-metal" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#D0D0D7" />
          <stop offset="100%" stop-color="#5F5F67" />
        </linearGradient>
      </defs>
      <ellipse cx="160" cy="132" rx="72" ry="5" fill="rgba(0,0,0,0.34)" />
      <rect x="98" y="34" width="12" height="98" rx="5" fill="#35353B" />
      <rect x="210" y="34" width="12" height="98" rx="5" fill="#35353B" />
      <rect x="98" y="34" width="124" height="10" rx="5" fill="#35353B" />
      <rect x="140" y="52" width="40" height="12" rx="6" fill="url(#machine-metal)" />
      <path d="M160 52 V22" stroke="#6A6A72" stroke-width="2" />
      <path d="M148 22 H172" stroke="#6A6A72" stroke-width="2" stroke-linecap="round" />
      <rect x="125" y="78" width="70" height="9" rx="4.5" fill="#232328" stroke="#3C3C42" />
      {[0, 1, 2, 3, 4].map((index) => (
        <rect x={132 + index * 10} y={92} width="7" height={28 - index * 3} rx="2" fill={index < 3 ? '#2F6FED' : '#6A6A72'} />
      ))}
      <text x="160" y="128" text-anchor="middle" fill="#5C5C63" font-size="9" font-family="system-ui" letter-spacing="1.4">
        {Math.round(load)} LB
      </text>
    </svg>
  )
}
