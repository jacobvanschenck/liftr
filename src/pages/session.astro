---
import Layout from '../layouts/Layout.astro';
import EquipmentArt from '../components/EquipmentArt.astro';
import {
  loadSessionLogger,
  renderSetList,
  type SessionLoggerExercise,
} from '../lib/session-logger';
import { BAR_WEIGHT, PLATES } from '../lib/plates';
import { formatLoad, relativeDateLabel, todayInTimeZone } from '../lib/dates';
import type { EquipmentCategory } from '../lib/types';

const member = Astro.locals.member;
if (member === null) return Astro.redirect('/sign-in');

const session = await loadSessionLogger(member);
const today = todayInTimeZone(member.timezone);
const error = Astro.url.searchParams.get('error');

const exercises = session?.exercises ?? [];
const totalSets = session?.totalSets ?? 0;
const targetSets = session?.targetSets ?? 0;
const initialIndex =
  session === null || session.firstIncompleteIndex === -1 ? 0 : session.firstIncompleteIndex;

function loggerConfigJson(config: SessionLoggerExercise['loggerConfig']): string {
  return JSON.stringify(config).replaceAll('<', '\\u003c');
}

const equipmentLabel: Record<EquipmentCategory, string> = {
  barbell: 'Barbell',
  dumbbell: 'Dumbbell',
  machine: 'Machine',
};
---

{
  session === null ? (
    <Layout title="Session" member={member} hideNav>
      <div class="state-page">
        <p class="state-code">No active session</p>
        <h1 class="state-title">Start from a routine.</h1>
        <p class="state-body">
          Pick a routine, and Liftr will lay out every exercise with your target sets and
          reps.
        </p>
        <a class="button primary" href="/routines">Choose a routine</a>
      </div>
    </Layout>
  ) : (
    <Layout title={session.routineName} member={member} hideNav>
      <div class="session-shell" x-data={`sessionPage(${exercises.length}, ${initialIndex})`}>
        <div class="session-top">
          <a class="icon-button" href="/routines" aria-label="Back to routines">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </a>
          <div class="session-heading">
            <div class="session-title">{session.routineName}</div>
            <div class="session-subtitle">
              {relativeDateLabel(session.trainingDate, today)} ·{' '}
              <span id="session-total">{totalSets}/{targetSets} sets</span>
            </div>
          </div>
          <button
            class="button small"
            type="button"
            onclick="document.getElementById('finish-dialog').showModal()"
          >
            Finish
          </button>
        </div>

        <div class="session-progress">
          <span x-effect="$el.style.width = progress + '%'"></span>
        </div>

        {error && <div class="form-error" style="margin-bottom:14px" role="alert">{error}</div>}

        {exercises.map((exercise, index) => (
          <section class="exercise-panel" x-show={`index === ${index}`} x-cloak>
            <div class="art-card">
              <EquipmentArt
                category={exercise.equipmentCategory}
                load={
                  exercise.sets.at(-1)?.load ??
                  exercise.previousSet?.load ??
                  (exercise.equipmentCategory === 'barbell' ? BAR_WEIGHT : 20)
                }
              />
            </div>

            <div class="exercise-panel" style="gap:16px" x-data={`setLogger(${loggerConfigJson(exercise.loggerConfig)})`} data-set-logger>
              <div class="logger-head">
                <div style="min-width:0">
                  <h2 class="logger-name">{exercise.name}</h2>
                  <div id={`progress-${exercise.id}`} class="logger-target">
                    {exercise.progressLabel}
                  </div>
                </div>
                <div class="previous-set" style="text-align:right;flex:0 0 auto">
                  {exercise.previousSet
                    ? <>Last: {exercise.previousSet.repetitions} × {formatLoad(exercise.previousSet.load)} lb</>
                    : 'First time'}
                </div>
              </div>

              <div class="controls">
                <div class="load-display">
                  <span class="load-value" x-text="displayLoad"></span>
                  <span class="load-unit">lb</span>
                </div>

                {exercise.equipmentCategory === 'barbell' ? (
                  <>
                    <div x-show="!manual" x-cloak>
                      <div class="plate-grid">
                        {PLATES.map((plate) => (
                          <div class="plate-cell">
                            <button
                              class="plate-button"
                              type="button"
                              @click={`addPlate(${plate})`}
                              aria-label={`Add ${plate} pound pair`}
                            >
                              <span class="plate-weight">{plate}</span>
                              <span class="plate-count" x-text={`(plates[${plate}] || 0) + ' pair'`}></span>
                            </button>
                            <button
                              class="plate-remove"
                              type="button"
                              x-show={`(plates[${plate}] || 0) > 0`}
                              @click={`removePlate(${plate})`}
                              aria-label={`Remove ${plate} pound pair`}
                            >
                              −
                            </button>
                          </div>
                        ))}
                      </div>
                      <div class="control-caption" style="margin-top:8px">
                        Bar {BAR_WEIGHT} lb · tap a plate to add a pair
                      </div>
                    </div>

                    <div x-show="manual" x-cloak>
                      <div class="stepper-row">
                        <button class="stepper" type="button" @click="setStack(-5)" aria-label="Decrease load">−</button>
                        <div class="reps-display">
                          <input
                            class="load-input"
                            type="number"
                            inputmode="decimal"
                            min="0"
                            step="0.5"
                            x-model="manualLoad"
                            aria-label="Load in pounds"
                          />
                          <span class="reps-label">lb</span>
                        </div>
                        <button class="stepper" type="button" @click="setStack(5)" aria-label="Increase load">+</button>
                      </div>
                    </div>

                    <button class="button ghost small" type="button" @click="toggleManual()">
                      <span x-text="manual ? 'Use plates instead' : 'Enter weight manually'"></span>
                    </button>
                  </>
                ) : (
                  <div class="stepper-row">
                    <button class="stepper" type="button" @click="setStack(-5)" aria-label="Decrease load">−</button>
                    <div class="reps-display">
                      <input
                        class="load-input"
                        type="number"
                        inputmode="decimal"
                        min="0"
                        step="0.5"
                        x-model="manualLoad"
                        aria-label="Load in pounds"
                      />
                      <span class="reps-label">lb · {equipmentLabel[exercise.equipmentCategory]}</span>
                    </div>
                    <button class="stepper" type="button" @click="setStack(5)" aria-label="Increase load">+</button>
                  </div>
                )}

                <div class="my-1 h-px bg-border"></div>

                <div class="flex items-center justify-between gap-3">
                  <span class="control-caption">Reps</span>
                  <span class="text-xs text-muted-foreground" x-show="editingSetId" x-cloak>Editing set</span>
                </div>

                <div class="stepper-row">
                  <button class="stepper" type="button" @click="setReps(-1)" aria-label="Decrease reps">−</button>
                  <div class="reps-display">
                    <input
                      class="reps-input"
                      type="number"
                      inputmode="numeric"
                      min="1"
                      max="1000"
                      x-model="reps"
                      aria-label="Repetitions"
                    />
                    <span class="reps-label">reps</span>
                  </div>
                  <button class="stepper" type="button" @click="setReps(1)" aria-label="Increase reps">+</button>
                </div>

                <form
                  hx-post="/api/sessions/set/save"
                  hx-target={`#sets-list-${exercise.id}`}
                  hx-swap="outerHTML"
                >
                  <input type="hidden" name="sessionExerciseId" value={exercise.id} />
                  <input type="hidden" name="setId" x-effect="$el.value = editingSetId ?? ''" />
                  <input type="hidden" name="reps" x-effect="$el.value = reps" />
                  <input type="hidden" name="load" x-effect="$el.value = load" />
                  <button class="button primary full" type="submit" >
                    <span x-text="editingSetId ? 'Save set' : 'Add set'"></span>
                  </button>
                  <button
                    class="button ghost full"
                    type="button"
                    x-show="editingSetId"
                    x-cloak
                    @click="cancelEdit()"
                  >
                    Cancel editing
                  </button>
                </form>
              </div>

              <div class="set-section">
                <div class="set-heading">
                  <span class="section-title">Sets</span>
                  <span class="text-xs text-muted-foreground" x-show="editingSetId" x-cloak>Editing</span>
                </div>
                <div id={`sets-list-${exercise.id}`} set:html={renderSetList(exercise)}></div>
              </div>
            </div>
          </section>
        ))}

        <div class="pager">
          <button class="icon-button" type="button" @click="previous()" x-effect="$el.disabled = isFirst" aria-label="Previous exercise">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <span class="pager-label">
            <span x-text="index + 1"></span> of {exercises.length}
          </span>
          <button class="icon-button" type="button" @click="next()" x-effect="$el.disabled = isLast" aria-label="Next exercise">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
          </button>
        </div>

        <div class="session-footer">
          <button
            class="button primary full"
            type="button"
            onclick="document.getElementById('finish-dialog').showModal()"
          >
            Finish session
          </button>
          <button
            class="button ghost full"
            type="button"
            onclick="document.getElementById('discard-dialog').showModal()"
          >
            Discard session
          </button>
        </div>
      </div>

      <dialog id="finish-dialog" class="dialog">
        <form class="dialog-inner" method="post" action="/api/sessions/complete">
          <input type="hidden" name="sessionId" value={session!.id} />
          <h2 class="dialog-title">Finish this session?</h2>
          <p class="dialog-body">
            You logged <span id="finish-total">{totalSets} of {targetSets}</span> target sets.
            Finishing locks the session and updates your dashboard and exercise history.
          </p>
          <div class="form-actions">
            <button class="button primary" type="submit">Finish session</button>
            <button class="button ghost" type="button" onclick="document.getElementById('finish-dialog').close()">Keep logging</button>
          </div>
        </form>
      </dialog>

      <dialog id="discard-dialog" class="dialog">
        <form class="dialog-inner" method="post" action="/api/sessions/discard">
          <input type="hidden" name="sessionId" value={session!.id} />
          <h2 class="dialog-title">Discard this session?</h2>
          <p class="dialog-body">
            This deletes every set recorded in this session. It cannot be undone.
          </p>
          <div class="form-actions">
            <button class="button danger" type="submit">Discard session</button>
            <button class="button ghost" type="button" onclick="document.getElementById('discard-dialog').close()">Keep logging</button>
          </div>
        </form>
      </dialog>
    </Layout>
  )
}
