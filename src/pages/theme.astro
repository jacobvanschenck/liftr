---
import Layout from '../layouts/Layout.astro';

const member = Astro.locals.member;
if (member === null) return Astro.redirect(Astro.locals.auth().userId ? '/403' : '/sign-in');

type Swatch = {
  name: string;
  token: string;
  utility: string;
  value: string;
  foreground?: string;
};

const swatches: Swatch[] = [
  {
    name: 'Background',
    token: '--background',
    utility: 'bg-background',
    value: '#08080A',
    foreground: '--foreground',
  },
  {
    name: 'Foreground',
    token: '--foreground',
    utility: 'text-foreground',
    value: '#F5F5F7',
    foreground: '--background',
  },
  {
    name: 'Card',
    token: '--card',
    utility: 'bg-card',
    value: '#141417',
    foreground: '--card-foreground',
  },
  {
    name: 'Popover',
    token: '--popover',
    utility: 'bg-popover',
    value: '#1C1C20',
    foreground: '--popover-foreground',
  },
  {
    name: 'Primary',
    token: '--primary',
    utility: 'bg-primary',
    value: '#0A84FF',
    foreground: '--primary-foreground',
  },
  {
    name: 'Secondary',
    token: '--secondary',
    utility: 'bg-secondary',
    value: '#1C1C20',
    foreground: '--secondary-foreground',
  },
  {
    name: 'Muted',
    token: '--muted',
    utility: 'bg-muted',
    value: '#1C1C20',
    foreground: '--muted-foreground',
  },
  {
    name: 'Accent',
    token: '--accent',
    utility: 'bg-accent',
    value: '#1C1C20',
    foreground: '--accent-foreground',
  },
  {
    name: 'Destructive',
    token: '--destructive',
    utility: 'bg-destructive',
    value: '#FF6B63',
    foreground: '--destructive-foreground',
  },
  {
    name: 'Border',
    token: '--border',
    utility: 'border-border',
    value: '#242429',
  },
  {
    name: 'Input',
    token: '--input',
    utility: 'border-input',
    value: '#34343B',
  },
  {
    name: 'Ring',
    token: '--ring',
    utility: 'ring-ring',
    value: '#0A84FF',
  },
  {
    name: 'Brand',
    token: '--brand',
    utility: 'bg-brand',
    value: '#0A84FF',
    foreground: '--primary-foreground',
  },
  {
    name: 'Success',
    token: '--success',
    utility: 'bg-success',
    value: '#32D74B',
    foreground: '--background',
  },
];
---

<Layout title="Theme" member={member}>
  <header class="page-header">
    <div>
      <p class="eyebrow">Design system</p>
      <h1 class="page-title">Theme</h1>
      <p class="page-subtitle">
        Dark-only tokens and component specimens. The vocabulary follows shadcn/ui.
      </p>
    </div>
    <a class="icon-button" href="/settings" aria-label="Back to settings">
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m15 18-6-6 6-6" />
      </svg>
    </a>
  </header>

  <section>
    <div class="section-heading">
      <h2 class="section-title">Color tokens</h2>
      <span class="text-xs text-muted-foreground">CSS variables → Tailwind utilities</span>
    </div>

    <div class="grid grid-cols-2 gap-2">
      {
        swatches.map((swatch) => (
          <div class="overflow-hidden rounded-md border border-border bg-card">
            <div
              class="flex h-20 items-end px-3 pb-2 text-lg font-750"
              style={`background: var(${swatch.token}); color: var(${swatch.foreground ?? '--foreground'})`}
            >
              Aa
            </div>
            <div class="border-t border-border p-3">
              <p class="text-sm font-650">{swatch.name}</p>
              <p class="mt-1 font-mono text-[11px] text-muted-foreground">{swatch.token}</p>
              <p class="font-mono text-[11px] text-brand">{swatch.utility}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-3 rounded-md border border-border bg-surface-soft p-4">
      <p class="text-sm font-650">Radius scale</p>
      <div class="mt-3 grid grid-cols-3 gap-2">
        <div class="rounded-sm border border-border bg-surface-raised p-3 text-center text-xs">
          rounded-sm
        </div>
        <div class="rounded-md border border-border bg-surface-raised p-3 text-center text-xs">
          rounded-md
        </div>
        <div class="rounded-lg border border-border bg-surface-raised p-3 text-center text-xs">
          rounded-lg
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-heading">
      <h2 class="section-title">Typography</h2>
    </div>
    <div class="grid gap-3 card">
      <div>
        <p class="eyebrow">Eyebrow</p>
        <p class="mt-1 text-xs text-muted-foreground">.eyebrow · text-[11px] uppercase tracking-[0.14em]</p>
      </div>
      <div class="my-1 h-px bg-border"></div>
      <div>
        <p class="text-[clamp(38px,10vw,56px)] font-760 leading-[0.95] tracking-[-0.06em]">
          Stronger every week.
        </p>
        <p class="mt-2 text-xs text-muted-foreground">Display · font-760 tracking-[-0.06em]</p>
      </div>
      <div>
        <h2 class="page-title">Page title</h2>
        <p class="mt-1 text-xs text-muted-foreground">.page-title</p>
      </div>
      <div>
        <h3 class="text-xl font-740 tracking-[-0.03em]">Section heading</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
          Body copy is 14px with relaxed leading. Muted copy uses
          <span class="font-mono text-brand">text-muted-foreground</span>.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="section-heading">
      <h2 class="section-title">Buttons</h2>
    </div>
    <div class="grid gap-3 card">
      <div class="flex flex-wrap gap-2">
        <button class="button" type="button">Default</button>
        <button class="button primary" type="button">Primary</button>
        <button class="button ghost" type="button">Ghost</button>
        <button class="button danger" type="button">Danger</button>
        <button class="button small" type="button">Small</button>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button class="icon-button" type="button" aria-label="Edit">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
        </button>
        <button class="icon-button accent" type="button" aria-label="Add">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M12 5v14M5 12h14" />
          </svg>
        </button>
        <button class="icon-button danger" type="button" aria-label="Delete">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" />
          </svg>
        </button>
        <button class="button primary full" type="button">Full-width primary</button>
      </div>
    </div>
  </section>

  <section>
    <div class="section-heading">
      <h2 class="section-title">Pills</h2>
    </div>
    <div class="card flex flex-wrap gap-2">
      <span class="pill">Default</span>
      <span class="pill accent">Accent</span>
      <span class="pill core">Core lift</span>
      <span class="pill danger">Danger</span>
      <span class="pill tabular-nums">135 × 5 lb</span>
    </div>
  </section>

  <section>
    <div class="section-heading">
      <h2 class="section-title">Form controls</h2>
    </div>
    <form class="card form">
      <label class="field">
        <span class="label">Exercise name</span>
        <input class="input" value="Bench press" />
        <span class="form-hint">Used in the catalog, routines, and every logged set.</span>
      </label>

      <div class="form-row">
        <label class="field">
          <span class="label">Equipment</span>
          <select class="select">
            <option>Barbell</option>
            <option>Dumbbell</option>
            <option>Machine</option>
          </select>
        </label>
        <label class="field">
          <span class="label">Target sets</span>
          <input class="input tabular-nums" type="number" value="4" />
        </label>
      </div>

      <label class="field">
        <span class="label">Notes</span>
        <textarea class="textarea" rows="3">Keep the bar path quiet.</textarea>
      </label>

      <label class="checkbox-row">
        <input type="checkbox" checked />
        <span>Count toward the strength score</span>
      </label>

      <div class="form-error" role="alert">This is an inline validation message.</div>

      <div class="form-actions">
        <button class="button primary" type="button">Save changes</button>
        <button class="button ghost" type="button">Cancel</button>
      </div>
    </form>
  </section>

  <section>
    <div class="section-heading">
      <h2 class="section-title">Cards</h2>
    </div>
    <div class="grid gap-3">
      <div class="card">
        <div class="list-title">Default card</div>
        <div class="list-meta">Gradient surface with a hairline border.</div>
      </div>
      <div class="card flat">
        <div class="list-title">Flat card</div>
        <div class="list-meta">Solid charcoal surface.</div>
      </div>
      <div class="card soft">
        <div class="list-title">Soft card</div>
        <div class="list-meta">Recessed surface for secondary content.</div>
      </div>
      <div class="card compact">
        <div class="list-title">Compact card</div>
        <div class="list-meta">Tighter padding and radius.</div>
      </div>
      <a class="card interactive" href="/theme">
        <div class="flex items-center justify-between gap-3">
          <div>
            <div class="list-title">Interactive card</div>
            <div class="list-meta">Hover and press states for tappable surfaces.</div>
          </div>
          <svg
            class="chevron"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </div>
      </a>
    </div>
  </section>

  <section>
    <div class="section-heading">
      <h2 class="section-title">Stats & lists</h2>
    </div>
    <div class="stat-grid">
      <div class="stat">
        <div class="stat-value">418</div>
        <div class="stat-label">Score</div>
      </div>
      <div class="stat">
        <div class="stat-value">3</div>
        <div class="stat-label">This week</div>
      </div>
      <div class="stat">
        <div class="stat-value">12</div>
        <div class="stat-label">Streak</div>
      </div>
    </div>

    <div class="mt-3 list">
      <a class="list-row" href="/theme">
        <span class="avatar accent">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 9v6M8 6v12M16 6v12M20 9v6M8 12h8" />
          </svg>
        </span>
        <span class="min-w-0 flex-1">
          <span class="list-title">Push Day</span>
          <span class="list-meta">4 exercises · 12 target sets</span>
        </span>
        <svg
          class="chevron"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m9 18 6-6-6-6" />
        </svg>
      </a>
      <a class="list-row" href="/theme">
        <span class="avatar">BP</span>
        <span class="min-w-0 flex-1">
          <span class="list-title">Bench press</span>
          <span class="list-meta">Barbell · core lift</span>
        </span>
        <svg
          class="chevron"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m9 18 6-6-6-6" />
        </svg>
      </a>
    </div>
  </section>

  <section>
    <div class="section-heading">
      <h2 class="section-title">Empty state</h2>
    </div>
    <div class="empty-state">
      <div class="empty-title">Nothing logged yet</div>
      <p class="empty-body">
        Start a routine and the session logger will keep every set, target, and plate change in one
        place.
      </p>
      <button class="button primary small" type="button">Start a session</button>
    </div>
  </section>

  <p class="form-hint mt-7 text-center">
    Tokens live in <span class="font-mono text-brand">src/styles/global.css</span>. Use
    <span class="font-mono text-brand">bg-background</span>,
    <span class="font-mono text-brand">text-muted-foreground</span>, and the rest of the theme
    utilities in new markup.
  </p>
</Layout>
