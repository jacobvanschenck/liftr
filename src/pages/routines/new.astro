---
import Layout from '../../layouts/Layout.astro';
import RoutineBuilder from '../../components/RoutineBuilder.astro';
import { listExercises } from '../../lib/exercises';
import { parseBuilderDraft } from '../../lib/builder';

const member = Astro.locals.member;
if (member === null) return Astro.redirect('/sign-in');

const catalog = await listExercises(member);
const error = Astro.url.searchParams.get('error');
const name = Astro.url.searchParams.get('name') ?? '';
const items = parseBuilderDraft(Astro.url.searchParams.get('items'));
---

<Layout title="New routine" member={member}>
  <header class="page-header">
    <div>
      <p class="eyebrow">Program</p>
      <h1 class="page-title">New routine</h1>
      <p class="page-subtitle">Order the movements, then set a target for each one.</p>
    </div>
    <a class="icon-button" href="/routines" aria-label="Cancel">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </a>
  </header>

  <RoutineBuilder mode="new" name={name} items={items} catalog={catalog} error={error} />
</Layout>
