---
import { SignOutButton } from '@clerk/astro/components';
import Layout from '../layouts/Layout.astro';
import { longDate } from '../lib/dates';

const member = Astro.locals.member;
if (member === null) return Astro.redirect(Astro.locals.auth().userId ? '/403' : '/sign-in');
---

<Layout title="Settings" member={member}>
  <header class="page-header">
    <div>
      <p class="eyebrow">Account</p>
      <h1 class="page-title">Settings</h1>
    </div>
    <a class="icon-button" href="/" aria-label="Home">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </a>
  </header>

  <section class="card">
    <div class="flex items-center gap-3">
      <div class="grid size-[54px] place-items-center rounded-2xl bg-brand-soft text-xl font-750 text-brand">
        {member.name.slice(0, 1).toUpperCase()}
      </div>
      <div class="min-w-0 flex-1">
        <div class="list-title" style="font-size:17px">{member.name}</div>
        <div class="list-meta">{member.email ?? 'Email managed by Clerk'}</div>
      </div>
      <span class="pill accent">Member</span>
    </div>

    <div class="my-1 h-px bg-border" style="margin:18px 0"></div>

    <div class="grid gap-2">
      <div class="flex items-center justify-between gap-3">
        <span class="text-muted-foreground text-xs">Timezone</span>
        <span class="text-xs">{member.timezone}</span>
      </div>
      <div class="flex items-center justify-between gap-3">
        <span class="text-muted-foreground text-xs">Member since</span>
        <span class="text-xs">{longDate(new Date(member.createdAt).toISOString().slice(0, 10))}</span>
      </div>
      <div class="flex items-center justify-between gap-3">
        <span class="text-muted-foreground text-xs">Family</span>
        <span class="text-xs">Liftr household</span>
      </div>
    </div>
  </section>

  <div class="section-heading">
    <h2 class="section-title">Account portal</h2>
  </div>
  <a
    class="card interactive"
    href="https://dynamic-flea-2535.clerk.accounts.dev/user"
    target="_blank"
    rel="noreferrer"
    style="display:block"
  >
    <div class="flex items-center justify-between gap-3">
      <div>
        <div class="list-title">Manage account</div>
        <div class="list-meta">Name, email, connected Google account</div>
      </div>
      <svg class="chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </div>
  </a>

  <div class="section-heading">
    <h2 class="section-title">App</h2>
  </div>
  <section class="card compact">
    <div class="grid gap-2">
      <div class="flex items-center justify-between gap-3">
        <span class="text-xs text-muted-foreground">Version</span>
        <span class="text-xs">0.1.0</span>
      </div>
      <div class="flex items-center justify-between gap-3">
        <span class="text-xs text-muted-foreground">Data</span>
        <span class="text-xs">Cloudflare D1 · online only</span>
      </div>
      <div class="flex items-center justify-between gap-3">
        <span class="text-xs text-muted-foreground">Install</span>
        <span class="text-xs">Share → Add to Home Screen</span>
      </div>
    </div>
  </section>

  <div class="section-heading">
    <h2 class="section-title">Design</h2>
  </div>
  <a class="card interactive" href="/theme" style="display:block">
    <div class="flex items-center justify-between gap-3">
      <div>
        <div class="list-title">Theme & styles</div>
        <div class="list-meta">Color tokens, type, and component specimens</div>
      </div>
      <svg class="chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </div>
  </a>

  <div class="section-heading">
    <h2 class="section-title">Session</h2>
  </div>
  <SignOutButton redirectUrl="/" asChild>
    <button class="button danger full" type="button">Sign out</button>
  </SignOutButton>

  <p class="form-hint" style="text-align:center;margin-top:18px">
    Liftr keeps your data private to this two-person family. It is not a social app.
  </p>
</Layout>
