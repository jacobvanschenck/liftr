{
  "name": "liftr",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "repository": "github:jacobvanschenck/liftr",
  "homepage": "https://liftr.jacobvs.workers.dev",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply liftr --local",
    "db:migrate:remote": "wrangler d1 migrations apply liftr --remote",
    "db:seed:local": "wrangler d1 execute liftr --local --file=./scripts/seed.sql",
    "db:export:remote": "wrangler d1 export liftr --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@clerk/astro": "4.1.18",
    "alpinejs": "3.17.5",
    "astro": "7.4.2",
    "htmx.org": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/alpinejs": "^3.17.0",
    "typescript": "^6.0.3",
    "wrangler": "4.153.0"
  }
}
