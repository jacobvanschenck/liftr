{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liftr",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liftr",
      "database_id": "8072960d-73d6-40ab-89b1-02a847f253c3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_ZHluYW1pYy1mbGVhLTI1MzUuY2xlcmsuYWNjb3VudHMuZGV2JA"
  }
}
